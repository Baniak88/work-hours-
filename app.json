{
  "expo": {
    "name": "Work Hours",
    "slug": "work-hours",
    "version": "1.9.3",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "workhours",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.baniak88.workhours",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.baniak88.workhours",
      "adaptiveIcon": {
        "backgroundColor": "#101314",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "versionCode": 12
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "name": "Work Hours",
      "shortName": "Work Hours",
      "themeColor": "#101314",
      "backgroundColor": "#101314",
      "output": "single"
    },
    "plugins": [
      "expo-sharing",
      "expo-font",
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "86faefaf-f618-43c3-8eb3-dbb853ce056d"
      }
    },
    "owner": "neospecto82"
  }
}
